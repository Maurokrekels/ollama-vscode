{
    "name": "ollama-chat-vscode",
    "displayName": "Ollama Local Chat",
    "description": "Chat with Ollama locally in VS Code",
    "version": "0.2.1",
    "engines": {
        "vscode": "^1.74.0"
    },
    "packageManager": "bun@1.2.3",
    "publisher": "MauroKrekels",
    "license": "MIT",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#000000",
        "theme": "dark"
    },
    "keywords": [
        "ollama",
        "chat",
        "vscode"
    ],
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:ollama.openChat",
        "onStartupFinished"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Maurokrekels/ollama-vscode"
    },
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "ollama.openChat",
                "title": "Open Ollama Chat"
            },
            {
                "command": "ollama.toggleAutocomplete",
                "title": "Toggle Ollama Autocomplete"
            },
            {
                "command": "ollama.leaveReview",
                "title": "Leave a Review for Ollama Local Chat"
            }
        ],
        "configuration": {
            "title": "Ollama",
            "properties": {
                "ollama.baseUrl": {
                    "type": "string",
                    "default": "http://localhost:11434",
                    "description": "Ollama API base URL"
                },
                "ollama.model": {
                    "type": "string",
                    "default": "llama3.2:latest",
                    "description": "Default Ollama model to use"
                },
                "ollama.autocomplete.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show inline code completions from Ollama"
                },
                "ollama.autocomplete.model": {
                    "type": "string",
                    "default": "qwen2.5-coder:3b",
                    "description": "Model for autocomplete. Must support fill-in-the-middle (e.g. qwen2.5-coder base models)"
                },
                "ollama.autocomplete.debounceMs": {
                    "type": "number",
                    "default": 300,
                    "description": "Wait time in ms after typing before requesting a completion"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "bun run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.74.0",
        "@types/node": "^16.18.126",
        "typescript": "^4.9.5"
    }
}
